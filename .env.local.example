# ==========================================
# 童設計 AI - 環境變數設定
# ==========================================
#
# 預設使用 Pollinations AI（完全免費，無需 API Key）
# 此檔案可留空，或僅設定選用變數
#
# --- 選用：未來擴充其他 AI Provider 時使用 ---
#
# Gemini API Key（若您所在地區可用 Google AI Studio）
# GEMINI_API_KEY=your_google_gemini_api_key_here
#
# Hugging Face Token（免費申請，模型選擇更多）
# HUGGINGFACE_API_KEY=hf_xxxxxxxxxxxxxxxxxxxx
#
# OpenAI API Key（如需 DALL-E 等高品質圖片生成）
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
#